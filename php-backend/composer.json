{
    "name": "saarika/php-backend",
    "description": "PHP port of the saarika backend API",
    "type": "project",
    "require": {
        "php": "^8.1",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.10",
        "kreait/firebase-php": "^7.13",
        "cloudinary/cloudinary_php": "^2.10",
        "phpmailer/phpmailer": "^6.9",
        "mongodb/mongodb": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
